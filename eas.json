{
  "cli": {
    "version": ">= 18.9.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_AUTH_API": "https://api.flyslearning.com/auth/api/v1",
        "EXPO_PUBLIC_TEST_API": "https://api.flyslearning.com/test/api/v1",
        "EXPO_PUBLIC_EBOOK_API": "https://api.flyslearning.com/ebook",
        "EXPO_PUBLIC_PAYMENT_API": "https://api.flyslearning.com/payment/api",
        "EXPO_PUBLIC_TOOL_API": "https://api.flyslearning.com/tools/api",
        "EXPO_PUBLIC_MENTORSHIP_API": "https://api.flyslearning.com/tools"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_AUTH_API": "https://api.flyslearning.com/auth/api/v1",
        "EXPO_PUBLIC_TEST_API": "https://api.flyslearning.com/test/api/v1",
        "EXPO_PUBLIC_EBOOK_API": "https://api.flyslearning.com/ebook",
        "EXPO_PUBLIC_PAYMENT_API": "https://api.flyslearning.com/payment/api",
        "EXPO_PUBLIC_TOOL_API": "https://api.flyslearning.com/tools/api",
        "EXPO_PUBLIC_MENTORSHIP_API": "https://api.flyslearning.com/tools"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_AUTH_API": "https://api.flyslearning.com/auth/api/v1",
        "EXPO_PUBLIC_TEST_API": "https://api.flyslearning.com/test/api/v1",
        "EXPO_PUBLIC_EBOOK_API": "https://api.flyslearning.com/ebook",
        "EXPO_PUBLIC_PAYMENT_API": "https://api.flyslearning.com/payment/api",
        "EXPO_PUBLIC_TOOL_API": "https://api.flyslearning.com/tools/api",
        "EXPO_PUBLIC_MENTORSHIP_API": "https://api.flyslearning.com/tools"
      }
    }
  },
  "submit": {
    "production": {}
  }
}